{
  "name": "apply_batch",
  "version": "1.0.0",
  "description": "Aplica até 32 criações, edições ou pastas como uma unidade aprovada, com diff por arquivo e recuperação local para undo.",
  "side_effects": "Altera vários arquivos no workspace selecionado. Qualquer falha operacional dispara rollback best-effort; uma confirmação cria um identificador de undo protegido por hashes.",
  "requires_approval": true,
  "risk": "high",
  "capabilities": ["workspace.batch.apply", "workspace.file.create", "workspace.file.edit", "workspace.directory.create"],
  "idempotent": false,
  "timeout_ms": 30000,
  "arguments": {
    "type": "object",
    "required": ["operations"],
    "properties": {
      "operations": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "required": ["tool", "arguments"],
              "properties": {
                "tool": {"const": "create_file"},
                "arguments": {
                  "type": "object",
                  "required": ["path", "content"],
                  "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 1024}, "content": {"type": "string", "maxLength": 131072}},
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["tool", "arguments"],
              "properties": {
                "tool": {"const": "edit_file"},
                "arguments": {
                  "type": "object",
                  "required": ["path", "old_text", "new_text"],
                  "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 1024}, "old_text": {"type": "string", "minLength": 1, "maxLength": 131072}, "new_text": {"type": "string", "maxLength": 131072}},
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["tool", "arguments"],
              "properties": {
                "tool": {"const": "create_directory"},
                "arguments": {
                  "type": "object",
                  "required": ["path"],
                  "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 1024}},
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "additionalProperties": false
  },
  "preconditions": ["workspace selecionado", "caminhos relativos dentro do workspace", "nenhum caminho aparece mais de uma vez", "confirmação explícita antes de escrever"],
  "effects": ["salva diff e backup por arquivo editado", "faz rollback das alterações aplicadas se uma operação falhar", "grava manifesto local de recuperação após sucesso"],
  "rollback": "undo_batch com transaction_id enquanto os hashes dos arquivos continuarem iguais aos resultados do lote",
  "retry_policy": "never_after_ambiguous_timeout",
  "limits": {"max_operations": 32, "max_total_text_bytes": 262144, "max_file_bytes": 131072, "shell_execution": false},
  "result": {"type": "object", "required": ["schema", "ok", "rollback_on_error", "transaction_id", "undo_available", "count", "operations"]}
}
