{
  "name": "search_files",
  "description": "Pesquisa texto em arquivos de uma pasta do workspace; devolve caminho e linha com limites de leitura.",
  "side_effects": false,
  "requires_approval": false,
  "arguments": {
    "type": "object",
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 1000,
        "description": "Texto ou símbolo exato a procurar."
      },
      "max_results": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Número máximo de ocorrências devolvidas; padrão 5."
      },
      "context_lines": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5,
        "description": "Linhas de contexto antes e depois de cada ocorrência; padrão 0 para manter a resposta compacta."
      },
      "path": {
        "type": "string",
        "description": "Pasta inicial relativa ao workspace; padrão raiz."
      }
    },
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "required": [
      "query",
      "matches"
    ],
    "properties": {
      "query": {
        "type": "string"
      },
      "matches": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "line": {
              "type": "integer"
            },
            "start_line": {
              "type": "integer"
            },
            "end_line": {
              "type": "integer"
            },
            "text": {
              "type": "string"
            },
            "text_truncated": {
              "type": "boolean"
            },
            "snippet": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
