  "service_apis": [
    {
      "id": "research.pipeline.run",
      "method": "POST",
      "path": "/api/v1/research",
      "description": "Pesquisa na web, abre páginas relevantes, sintetiza com citações e pode preparar conteúdo para o acervo local.",
      "domain_tags": [
        "research",
        "learning"
      ],
      "provider": "local-research-runtime",
      "network_policy": "external-optional",
      "side_effects": "optional-corpus-write",
      "requires_approval": false,
      "risk": "external-read",
      "idempotent": false,
      "timeout_ms": 45000,
      "async": false,
      "request_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "topic": {
            "type": "string",
            "maxLength": 100
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "save_to_corpus": {
            "type": "boolean"
          },
          "category": {
            "type": "string"
          },
          "output": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "response_schema": {
        "type": "object",
        "required": [
          "answer",
          "pages",
          "citation_ids",
          "grounded"
        ],
        "properties": {
          "answer": {
            "type": "string"
          },
          "pages": {
            "type": "array"
          },
          "citation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grounded": {
            "type": "boolean"
          },
          "saved_to_corpus": {
            "type": [
              "string",
              "null"
            ]
          },
          "saved_count": {
            "type": "integer"
          }
        }
      }
    },
    {
      "id": "learning.topic.start",
      "method": "POST",
      "path": "/api/learn",
      "description": "Inicia job local que pesquisa fontes, avalia evidências, constrói currículo e práticas, e atualiza o ledger de competências.",
      "domain_tags": [
        "research",
        "learning",
        "programming"
      ],
      "provider": "local-learning-worker",
      "network_policy": "external-optional",
      "side_effects": "knowledge-and-skill-ledger-write",
      "requires_approval": false,
      "risk": "local-learning-write",
      "idempotent": false,
      "timeout_ms": 5000,
      "async": true,
      "request_schema": {
        "type": "object",
        "required": [
          "topic"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "additionalProperties": false
      },
      "response_schema": {
        "type": "object",
        "required": [
          "job"
        ],
        "properties": {
          "job": {
            "type": "object",
            "required": [
              "id",
              "topic",
              "status",
              "progress",
              "logs"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "running",
                  "completed",
                  "failed"
                ]
              },
              "progress": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "logs": {
                "type": "array"
              }
            }
          }
        }
      }
    },
    {
      "id": "learning.topic.status",
      "method": "GET",
      "path": "/api/learn/{job_id}",
      "description": "Consulta progresso, fontes, avaliação e prática de um job de aprendizado local.",
      "domain_tags": [
        "learning",
        "observability"
      ],
      "provider": "local-learning-worker",
      "network_policy": "offline",
      "side_effects": false,
      "requires_approval": false,
      "risk": "read",
      "idempotent": true,
      "timeout_ms": 5000,
      "async": false,
      "request_schema": {
        "type": "object",
        "required": [
          "job_id"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{32}$"
          }
        },
        "additionalProperties": false
      },
      "response_schema": {
        "type": "object",
        "required": [
          "ok",
          "job"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "job": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "progress": {
                "type": "integer"
              },
              "sources": {
                "type": "array"
              },
              "evidence": {
                "type": "object"
              },
              "laboratory": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
