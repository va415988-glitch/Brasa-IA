            "type": "object"
          },
          "audit": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "learning.autonomous.tick",
      "method": "POST",
      "path": "/api/v1/learning/autonomous/tick",
      "description": "Observa o estado e inicia no máximo um ciclo de aprendizado limitado quando a política permite.",
      "domain_tags": [
        "learning",
