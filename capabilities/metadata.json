    {
      "id": "dialogue.turn.generate",
      "method": "POST",
      "path": "/api/v1/dialogue/turn",
      "description": "Gera uma resposta contextual usando exclusivamente o checkpoint neural próprio, com histórico, evidências e gate de qualidade.",
      "domain_tags": [
        "dialogue",
        "reasoning",
        "conversation"
      ],
      "provider": "project-neural-checkpoint",
      "network_policy": "offline",
      "side_effects": "local-neural-inference",
      "requires_approval": false,
      "risk": "local-inference",
      "idempotent": false,
      "timeout_ms": 300000,
      "async": false,
      "request_schema": {
        "type": "object",
        "required": [
          "schema",
          "messages"
        ],
        "properties": {
          "schema": {
            "const": "agent-dialogue-request/v1"
          },
          "request_id": {
            "type": "string",
            "maxLength": 160
          },
          "provider": {
            "enum": [
              "local",
              "own-checkpoint"
            ]
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 80,
            "items": {
              "type": "object",
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "user",
                    "assistant",
                    "tool"
                  ]
                },
                "content": {
                  "type": "string",
                  "maxLength": 12000
                }
              },
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "source",
                "text"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "maxLength": 240
                },
                "text": {
                  "type": "string",
                  "maxLength": 4000
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "response_schema": {
        "type": "object",
        "required": [
          "schema",
          "ok",
          "request_id"
        ],
        "properties": {
          "schema": {
            "const": "agent-dialogue-response/v1"
          },
          "ok": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "dialogue": {
            "type": "object"
          },
          "generation": {
            "type": "object"
          },
          "error": {
            "type": "string"
          },
          "error_code": {
            "type": "string"
          }
        }
      }
    },
